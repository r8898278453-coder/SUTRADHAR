{
  "name": "@sutradhar/desktop",
  "productName": "SUTRADHAR Desktop Alpha",
  "description": "Owner-assisted PC agent with Electron first-run wizard — ALPHA, NOT PRODUCTION",
  "private": true,
  "version": "7.0.0-alpha.1",
  "main": "main.cjs",
  "type": "commonjs",
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "start": "electron .",
    "pack:qa": "node pack-qa.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.sutradhar.desktop.alpha",
    "productName": "SUTRADHAR Desktop Alpha",
    "asar": true,
    "directories": {
      "output": "out"
    },
    "files": [
      "package.json",
      "main.cjs",
      "preload.cjs",
      "desktop-config.cjs",
      "setup.html",
      "setup.js",
      "setup.css",
      "contract.json"
    ],
    "extraResources": [
      { "from": "dist/edge-agent.cjs", "to": "edge-agent.cjs" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": [ "x64" ] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": null
  }
}

# V7 Central - set all credentials in Hostinger environment, NOT in Git.
SUTRADHAR_ADMIN_KEY=
SUTRADHAR_ENROLLMENT_CODE=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternative connection variable: SUTRADHAR_MYSQL_URL=mysql://user:password@127.0.0.1:3306/name
# Use for one-time schema creation only, disable and restart afterwards:
SUTRADHAR_ALLOW_MIGRATIONS=false
# Turn on only if MySQL server requires and supports verified TLS:
SUTRADHAR_MYSQL_TLS=false
SUTRADHAR_GITHUB_REPOSITORY=
SUTRADHAR_GITHUB_TOKEN=
SUTRADHAR_REQUIRED_CHECKS=
SUTRADHAR_MIN_GITHUB_APPROVALS=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_ADMIN_USER_ID=
# Edge PC environment only:
SUTRADHAR_CENTRAL_URL=
SUTRADHAR_NODE_NAME=
SUTRADHAR_GENERAL_LOCATION=
SUTRADHAR_AGENT_IDS=
SUTRADHAR_NODE_DIR=

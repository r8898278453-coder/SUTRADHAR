# Configure a high-entropy admin credential (32+ random bytes recommended).
# If omitted, local development creates .sutradhar_state/secrets/admin_api_key.txt.
SUTRADHAR_ADMIN_KEY=

# Worker access is disabled unless BOTH a 32+ character secret and worker ID are set.
# One worker identity per process; true per-worker credential management remains pending.
SUTRADHAR_WORKER_ID=
SUTRADHAR_WORKER_KEY=

# Private signer material must live outside Git. Previously committed signing key
# must be rotated, and old leases invalidated after the rotation.
SUTRADHAR_PRIVKEY_PATH=
SUTRADHAR_PUBKEY_PATH=

# Real LLM providers. Without either provider, synthesis fails closed.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Real Docker execution: must reference a trusted local Git checkout.
# Never expose these values to frontend/API callers.
SUTRADHAR_TARGET_REPO_ROOT=
SUTRADHAR_SANDBOX_TEST_COMMAND=
SUTRADHAR_PYTHON=python3

# Read-only GitHub PR merge evidence verification (no push/merge API).
# Token must have access to contents, pull requests and check runs of target repo.
SUTRADHAR_GITHUB_REPOSITORY=
SUTRADHAR_GITHUB_TOKEN=
# Semicolon-separated; exact GitHub Actions job check names may contain commas:
SUTRADHAR_REQUIRED_CHECKS=
# At least one independent APPROVED review is required (default 1).
SUTRADHAR_MIN_GITHUB_APPROVALS=1

# Guarded worker branch publisher (OFF by default).
# Only pushes a NEW worker branch whose exact Git tree passed real Docker;
# never commits to or pushes main, never force-pushes, never auto-merges.
# Use a fine-grained Contents:read/write token, distinct from PR token.
SUTRADHAR_ENABLE_WORKER_PUSH=false
SUTRADHAR_GITHUB_PUSH_TOKEN=

# Owner-controlled, draft-ONLY GitHub PR creation for an already-pushed
# Docker-tested worker branch. Off unless explicitly enabled.
# Use a separate fine-grained token with Contents:read, Pull requests:read/write.
# Never place the token in code, a ticket, browser, or audit log.
SUTRADHAR_ENABLE_PR_CREATION=false
SUTRADHAR_GITHUB_PR_TOKEN=

# Reviewed emergency rollback pipeline (OFF by default).
# May prepare a new revert branch ONLY when original verified GitHub merge
# remains exact main HEAD and restored first-parent tree passes real Docker.
# Requires a separate fine-grained Contents read/write token; no main push.
# Draft PR uses SUTRADHAR_GITHUB_PR_TOKEN; final verification uses the
# independently configured read-only SUTRADHAR_GITHUB_TOKEN.
SUTRADHAR_ENABLE_ROLLBACK=false
SUTRADHAR_GITHUB_ROLLBACK_TOKEN=

# Telegram privileged commands require both approved chat AND admin user IDs.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_ADMIN_USER_IDS=

# In production run behind HTTPS. Administrator login creates a Secure HttpOnly cookie.
# No caller-supplied demo header is accepted for simulated execution.
